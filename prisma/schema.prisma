generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELER
  GUIDE
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?
  role      Role     @default(TRAVELER)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]
  bookings  Booking[]
  reviews   Review[]
}

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameFa      String
  country     String   @default("Iran")
  city        String?
  description String?
  heroImage   String?
  latitude    Float?
  longitude   Float?
  featured    Boolean  @default(false)
  hotels      Hotel[]
  trips       TripDestination[]
  createdAt   DateTime @default(now())
}

model Hotel {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  nameEn        String
  nameFa        String
  starRating    Float?
  address       String?
  basePrice     Decimal?    @db.Decimal(12, 2)
  currency      String      @default("IRR")
  images        String[]
  active        Boolean     @default(true)
  bookings      Booking[]
  reviews       Review[]
}

model Trip {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  title       String
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?          @db.Decimal(12, 2)
  currency    String            @default("IRR")
  status      String            @default("planning")
  destinations TripDestination[]
  items       TripItem[]
  bookings    Booking[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model TripDestination {
  tripId        String
  destinationId String
  order         Int      @default(0)
  trip          Trip        @relation(fields: [tripId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])
  @@id([tripId, destinationId])
}

model TripItem {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  title     String
  type      String
  dayNumber Int
  position  Int      @default(0)
  notes     String?
  cost      Decimal? @db.Decimal(12, 2)
}

model Booking {
  id        String        @id @default(cuid())
  refCode   String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  tripId    String?
  trip      Trip?         @relation(fields: [tripId], references: [id])
  hotelId   String?
  hotel     Hotel?        @relation(fields: [hotelId], references: [id])
  status    BookingStatus @default(PENDING)
  total     Decimal       @db.Decimal(12, 2)
  currency  String        @default("IRR")
  createdAt DateTime      @default(now())
}

model Guide {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  languages String[]
  city      String?
  rating    Float    @default(0)
  verified  Boolean  @default(false)
}

model Experience {
  id          String   @id @default(cuid())
  titleEn     String
  titleFa     String
  city        String
  category    String
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("IRR")
  active      Boolean  @default(true)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hotelId   String?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id])
  rating    Float
  title     String?
  body      String?
  createdAt DateTime @default(now())
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleFa   String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
